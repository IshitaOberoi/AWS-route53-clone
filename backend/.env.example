# SQLite database location. In Docker / Railway use a volume: sqlite:////data/route53.db
DATABASE_URL=sqlite:///./route53.db
# Comma-separated list (or JSON array) of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
# Set to true in production (HTTPS) so the session cookie gets the Secure flag.
COOKIE_SECURE=false
# Sliding session lifetime in days.
SESSION_TTL_DAYS=7
# Insert the demo user + demo zones into an empty database on startup.
SEED_DEMO_DATA=true
